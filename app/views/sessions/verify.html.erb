<div class="signin">
  <div>
    <%= render "layouts/rose", size: 48 %>
  </div>
  <p class="signin__title">Grateful Deploy</p>
  <%= form_with url: confirm_session_path, method: :post, class: "signin__form" do |f| %>
    <h1>Enter your code</h1>
    <p>We emailed a 6-digit code to <%= @identity.email %>.</p>
    <%= f.hidden_field :identity_id, value: @identity.id %>
    <%= f.label :code, "Code" %>
    <%= f.text_field :code, inputmode: "numeric", pattern: "[0-9]*", maxlength: 6, required: true, autofocus: true %>
    <%= f.submit "Sign in", class: "button" %>
  <% end %>
</div>
