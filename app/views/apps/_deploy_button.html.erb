<% if app.deploy_in_flight? %>
  <button class="button bear-row" disabled><%= render "shared/bear", size: 32, app: app %>Deploy in progress</button>
<% elsif (reason = app.deploy_blocked_reason) %>
  <div>
    <button class="button" disabled>Deploy</button>
    <p class="deploy-blocked muted"><%= reason %>.</p>
  </div>
<% else %>
  <%= button_to "Deploy", app_deploys_path(app), class: "button",
        data: { turbo_confirm: deploy_confirm(app, preview), confirm_url: app_ship_preview_path(app, format: :text) } %>
<% end %>
